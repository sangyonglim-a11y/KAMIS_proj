# Server-only secrets — never expose to the Vite client
PORT=3001

# Google Sheet CSV (시세 tab). Public viewer sheets work without login.
# Example for documented sheet:
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1hKZvI3-q0tGP84-za1UTrswVRVdsTaR_Y1HkIiAuzZs/gviz/tq?tqx=out:csv&sheet=%EC%8B%9C%EC%84%B8
SHEET_CSV_URL=

# Apps Script web app (품목 추가). Optional APP_TOKEN.
GAS_WEBAPP_URL=
GAS_APP_TOKEN=

# KAMIS Open API (실시간 프록시 /api/kamis)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 공공데이터포털 일별 도·소매 (시트 없을 때 폴백)
DATA_GO_KR_SERVICE_KEY=

# Gemini (로컬 JSON 수집 시). 없으면 시세만 저장.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
