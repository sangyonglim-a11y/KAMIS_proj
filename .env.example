# === Vercel / Next.js (서버 전용, NEXT_PUBLIC_ 없음) ===

# Apps Script 웹앱 URL (doGet/doPost). 배포 후 /exec 주소
GAS_WEBAPP_URL=

# Apps Script 스크립트 속성의 APP_TOKEN 과 동일 (선택)
GAS_APP_TOKEN=

# 구글 시트 CSV — 탭별 (링크 있는 사용자 뷰어 권장)
# https://docs.google.com/spreadsheets/d/{SHEET_ID}/gviz/tq?tqx=out:csv&sheet=야채시세
VEG_SHEET_CSV_URL=
MEAT_SHEET_CSV_URL=

# 하위 호환: 야채 CSV만 쓸 때
SHEET_CSV_URL=

# Gemini (Next 로컬 폴백 또는 Apps Script 속성에도 동일 키 설정)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 채소 폴백 (선택)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
DATA_GO_KR_SERVICE_KEY=
